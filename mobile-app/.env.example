# ==============================================================================
# GÉNESIS APP - MOBILE APP CONFIGURATION (.ENV.EXAMPLE)
# ==============================================================================

# API Base URL for backend requests
# Use http://10.0.2.2:8000/api/v1 for Android Emulator
# Use http://localhost:8000/api/v1 for iOS Simulator or physical devices on the same network
API_BASE_URL=http://localhost:8000/api/v1

# Web Google Client ID (if using google sign_in on web view/oauth)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
