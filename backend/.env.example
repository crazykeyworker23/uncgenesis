# ==============================================================================
# GÉNESIS APP - BACKEND CONFIGURATION (.ENV.EXAMPLE)
# ==============================================================================

# Django settings
SECRET_KEY=django-insecure-change-me-in-production-1234567890!@#
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,webadmin

# Database Settings (PostgreSQL)
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://genesis_admin:genesis_secure_password@db:5432/genesis_db

# Redis Settings (Cache, Celery Broker/Backend)
# Format: redis://host:port/db_number
REDIS_URL=redis://redis:6379/0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth Credentials (for mobile/admin login with Google)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Firebase Cloud Messaging: sin esto los avisos se registran y se ven dentro
# de la app, pero NO llegan al telefono con la aplicacion cerrada.
#
# Se descarga en la consola de Firebase (proyecto uncgenesis):
#   Configuracion del proyecto > Cuentas de servicio > Generar nueva clave privada
#
# Admite dos formas. En el servidor es mas seguro la ruta al archivo, porque la
# clave privada lleva saltos de linea que se estropean al pegarla:
#   FIREBASE_CREDENTIALS=/etc/genesis/firebase.json
# o el JSON entero en una sola linea:
#   FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_PROJECT_ID=uncgenesis
FIREBASE_CREDENTIALS=/etc/genesis/firebase.json

# Email SMTP Settings (For password reset / contact notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=genesisweeklyminute@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-email-password-here
