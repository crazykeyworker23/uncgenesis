# === Configuración Global de Producción / VPS ===

# Puerto público en el VPS (por defecto 80 para HTTP)
PORT=80

# Seguridad de Django
DEBUG=False
SECRET_KEY=cambiar_por_una_clave_secreta_segura_de_django
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com,tu-ip-vps
CORS_ALLOWED_ORIGINS=http://localhost,http://tu-dominio.com,http://tu-ip-vps

# Base de datos PostgreSQL
POSTGRES_DB=genesis_db
POSTGRES_USER=genesis_admin
POSTGRES_PASSWORD=cambiar_por_contrasena_segura

# Redis
REDIS_URL=redis://redis:6379/0
