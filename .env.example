# === Configuración Global de Producción / VPS ===

# Puerto público en el VPS (ejemplo 8080 para evitar conflictos con otros servidores web)
PORT=8080

# Seguridad de Django
DEBUG=False
SECRET_KEY=cambiar_por_una_clave_secreta_segura_de_django
ALLOWED_HOSTS=localhost,127.0.0.1,72.61.48.152
CORS_ALLOWED_ORIGINS=http://localhost,http://72.61.48.152:8080

# Base de datos PostgreSQL
POSTGRES_DB=genesis_db
POSTGRES_USER=genesis_admin
POSTGRES_PASSWORD=cambiar_por_contrasena_segura

# Redis
REDIS_URL=redis://redis:6379/0
